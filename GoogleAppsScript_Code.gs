/** Driving Log — bound to your existing Google spreadsheet.
 * Headers: Trip ID | Date | Entity | Notes | Route | Stops | Total KM
 * Insert Entity before Notes; header-based mapping preserves existing columns.
 * Accepts the current app's calculated/manual mileage and older address-only requests.
 */
const SHEET_NAME = "Trips";
const TIME_ZONE = "America/Toronto";

const KNOWN_LOCATIONS = [
  ["CEC Board Office", ["80 Sheppard", "CEC Board"]],
  ["Chaminade College", ["490 Queen", "Chaminade"]],
  ["St. John Paul II", ["685 Military", "John Paul"]],
  ["St. Columba", ["1054 Military", "Columba"]],
  ["St. Mother Teresa", ["440 Sewell", "Mother Teresa"]],
  ["Madonna CSS", ["20 Cresswell", "Madonna"]],
  ["St. Basil-the-Great", ["20 Weston", "Basil-the-Great"]],
  ["Maria Goretti", ["21 Tabor", "Goretti"]],
  ["St. Agatha", ["Agatha"]],
  ["St. Nicholas", ["Nicholas"]],
  ["St. Barnabas", ["St Barnabas", "St. Barnabas"]],
  ["Notre Dame CSS (Ajax)", ["1375 Harwood"]],
  ["Notre Dame HS (Toronto)", ["12 Malvern"]],
  ["Notre Dame CSS (Brampton)", ["2 Notre Dame"]],
  ["St. Mary CSS (Pickering)", ["1918 Whites"]],
  ["St. Mary Academy (Toronto)", ["66 Dufferin Park"]],
  ["St. Joan of Arc (Scarborough)", ["959 Midland"]],
  ["St. Joan of Arc (Mississauga)", ["3801 Thomas"]],
  ["St. Joseph's College (Toronto)", ["74 Wellesley"]],
  ["St. Joseph Secondary (Mississauga)", ["5555 Creditview"]],
  ["St. Francis Xavier (Mississauga)", ["50 Bristol"]],
  ["Pine Ridge SS", ["2155 Liverpool", "Pine Ridge"]],
  ["Pickering HS", ["180 Church", "Pickering High"]],
  ["Milliken Mills HS", ["7522 Kennedy", "Milliken Mills"]],
  ["Downtown Office", ["100 Queen", "City Hall"]]
];

function doGet() {
  try {
    const context = readSheet();
    const trips = [];
    let totalKm = 0;
    for (let r = context.data.length - 1; r >= 1; r--) {
      const row = context.data[r];
      if (!row.some(value => value !== "" && value !== null)) continue;
      const trip = tripFromRow(row, context.columns, "ROW-" + r);
      trips.push(trip);
      totalKm += trip.totalKm;
    }
    return createJsonResponse({ success: true, status: "success",
      supportsEntity: context.columns.entity >= 0,
      sheetUrl: context.ss.getUrl(), totalKm: roundKm(totalKm), count: trips.length, trips: trips });
  } catch (error) {
    return errorResponse(error);
  }
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  let locked = false;
  try {
    if (!e || !e.postData || !e.postData.contents) throw new Error("Missing request body.");
    const payload = JSON.parse(e.postData.contents);
    if (!payload || typeof payload !== "object" || Array.isArray(payload)) throw new Error("Invalid request body.");

    // Preserve your existing optional server-side key check for every write.
    const secret = PropertiesService.getScriptProperties().getProperty("DRIVING_LOG_SECRET");
    if (secret && payload.secret !== secret) throw new Error("Unauthorized: invalid or missing secret key.");

    locked = lock.tryLock(10000);
    if (!locked) return createJsonResponse({ success: false, status: "error", retryable: true,
      error: "Server busy. Retry this pending trip shortly.", message: "Server busy. Retry this pending trip shortly." });

    const context = readSheet();
    if (payload.entity !== undefined && context.columns.entity < 0) {
      throw new Error("Insert an Entity column before Notes (C: Entity, D: Notes). No trip was changed.");
    }
    let result;
    if (payload.action === "update") result = updateTrip(context, payload);
    else if (!payload.action || payload.action === "create") result = createTrip(context, payload);
    else throw new Error("Unsupported action.");

    // Commit spreadsheet changes before releasing exclusive access or confirming success.
    SpreadsheetApp.flush();
    return createJsonResponse(result);
  } catch (error) {
    return errorResponse(error);
  } finally {
    if (locked) lock.releaseLock();
  }
}

function createTrip(context, payload) {
  const stops = payload.stops;
  if (!Array.isArray(stops) || stops.length < 2 ||
      stops.some(stop => typeof stop !== "string" || !stop.trim())) {
    throw new Error("At least two valid stop addresses are required.");
  }
  const date = validateDate(payload.date || Utilities.formatDate(new Date(), TIME_ZONE, "yyyy-MM-dd"));
  const notes = String(payload.notes || payload.purpose || "Trip");
  const fields = tripFields(payload.entity, notes);
  const suppliedId = String(payload.id || payload.tripId || "").trim();
  if (suppliedId && !/^[A-Za-z0-9_-]{1,180}$/.test(suppliedId)) throw new Error("Invalid trip ID.");

  // Prefer the app's stable ID. Also recognize IDs generated by the previous backend.
  const requestKey = String(payload.requestId || payload.timestamp || suppliedId);
  if (!requestKey) throw new Error("Missing submission ID. Refresh the app before recording this trip.");
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    JSON.stringify([requestKey, stops, date, notes, payload.routeSummary || ""]));
  const legacyId = "TRIP-" + date.replace(/-/g, "") + "-" +
    digest.map(byte => (byte & 255).toString(16).padStart(2, "0")).join("");
  const id = suppliedId || legacyId;
  const c = context.columns;
  const existing = context.data.slice(1).find(row =>
    String(row[c.id]) === id || String(row[c.id]) === legacyId);
  if (existing) return successResponse("existing", tripFromRow(existing, c), true);

  // A supplied distance must be valid; never silently replace invalid input with zero.
  let suppliedKm;
  if (payload.totalKm !== undefined) suppliedKm = payload.totalKm;
  else if (payload.distanceKm !== undefined) suppliedKm = payload.distanceKm;
  else if (payload.km !== undefined) suppliedKm = payload.km;
  const km = suppliedKm !== undefined ? validateKm(suppliedKm) : calculateDistance(stops);
  const route = cleanRouteString(payload.routeSummary || payload.route || stops.join(" → "));
  const row = new Array(context.data[0].length).fill("");
  row[c.id] = id;
  row[c.date] = date;
  if (c.entity >= 0) row[c.entity] = fields.entity;
  row[c.notes] = sheetText(c.entity >= 0 ? fields.notes : notes);
  row[c.route] = sheetText(route);
  row[c.stops] = stops.length;
  row[c.km] = km;
  context.sheet.appendRow(row);
  return successResponse("created", { id: id, tripId: id, date: date, entity: c.entity >= 0 ? fields.entity : "", notes: c.entity >= 0 ? fields.notes : notes,
    route: route, rawRoute: route, stops: stops.length, stopsCount: stops.length,
    totalKm: km, km: km, synced: true }, false);
}

function updateTrip(context, payload) {
  const id = String(payload.id || payload.tripId || "").trim();
  if (!id) throw new Error("Missing trip ID for update.");
  const c = context.columns;
  // Match an actual ID first. A ROW-n fallback applies only to rows without an ID.
  let index = context.data.findIndex((row, r) => r > 0 && String(row[c.id]) === id);
  if (index < 0) index = context.data.findIndex((row, r) =>
    r > 0 && !row[c.id] && id === "ROW-" + r);
  if (index < 0) throw new Error("Trip not found. No rows were changed.");

  const row = context.data[index].slice();
  const changes = {};
  if (payload.entity !== undefined || payload.notes !== undefined) {
    const fields = tripFields(payload.entity !== undefined ? payload.entity : (c.entity >= 0 ? row[c.entity] : ""),
      payload.notes !== undefined ? payload.notes : row[c.notes]);
    if (c.entity >= 0) changes[c.entity] = fields.entity;
    changes[c.notes] = sheetText(c.entity >= 0 ? fields.notes : (payload.notes !== undefined ? payload.notes : row[c.notes]));
  }
  if (payload.date !== undefined) changes[c.date] = validateDate(payload.date);
  if (payload.route !== undefined) {
    if (!String(payload.route).trim()) throw new Error("Route cannot be empty.");
    changes[c.route] = sheetText(cleanRouteString(payload.route));
  }
  if (payload.totalKm !== undefined) changes[c.km] = validateKm(payload.totalKm);
  if (payload.stops !== undefined) {
    const count = Number(payload.stops);
    if (!Number.isInteger(count) || count < 1) throw new Error("Stops must be a positive whole number.");
    changes[c.stops] = count;
  }
  // Keep all validation ahead of the write, preserving unrelated formulas.
  const range = context.sheet.getRange(index + 1, 1, 1, row.length);
  const formulas = range.getFormulas()[0];
  const values = row.map((value, column) => formulas[column] || value);
  Object.keys(changes).forEach(column => { values[column] = changes[column]; row[column] = changes[column]; });
  range.setValues([values]);
  return successResponse("updated", tripFromRow(row, c, id), false);
}

function calculateDistance(stops) {
  let meters = 0;
  for (let i = 0; i < stops.length - 1; i++) {
    const directions = Maps.newDirectionFinder().setOrigin(stops[i]).setDestination(stops[i + 1])
      .setMode(Maps.DirectionFinder.Mode.DRIVING).getDirections();
    const legs = directions && directions.routes && directions.routes[0] && directions.routes[0].legs;
    if (!directions || directions.status !== "OK" || !legs || !legs.length) {
      throw new Error("Cannot calculate route leg " + (i + 1) + ". Check the addresses. No trip was saved.");
    }
    legs.forEach(leg => {
      const value = leg.distance && leg.distance.value;
      if (typeof value !== "number" || !Number.isFinite(value) || value < 0) {
        throw new Error("Invalid route distance. No trip was saved.");
      }
      meters += value;
    });
  }
  return validateKm(meters / 1000);
}

function readSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error("Open Apps Script from your Trip Log spreadsheet using Extensions > Apps Script.");
  const sheet = ss.getSheetByName(SHEET_NAME) || ss.getSheets()[0];
  const data = sheet.getDataRange().getValues();
  const headers = data[0].map(value => String(value).trim().toLowerCase());
  const columns = {
    id: headers.findIndex(h => h === "trip id" || h === "id"),
    date: headers.findIndex(h => h === "date" || h === "trip date"),
    entity: headers.findIndex(h => h === "entity" || h === "tax entity"),
    notes: headers.findIndex(h => h === "notes" || h === "purpose" || h === "note"),
    route: headers.findIndex(h => h === "route" || h === "route summary"),
    stops: headers.findIndex(h => h === "stops" || h === "stop count" || h === "stops count"),
    km: headers.findIndex(h => h === "total km" || h === "km" || h === "distance km")
  };
  if (Object.keys(columns).some(key => key !== "entity" && columns[key] < 0)) {
    throw new Error("Row 1 must contain: Trip ID, Date, Notes, Route, Stops, Total KM.");
  }
  return { ss: ss, sheet: sheet, data: data, columns: columns };
}

function tripFromRow(row, c, fallbackId) {
  const id = String(row[c.id] || fallbackId || "");
  const date = row[c.date] instanceof Date
    ? Utilities.formatDate(row[c.date], TIME_ZONE, "yyyy-MM-dd") : String(row[c.date] || "").slice(0, 10);
  const km = Number(row[c.km]);
  const totalKm = Number.isFinite(km) ? roundKm(km) : 0;
  const stops = Number(row[c.stops]) || 0;
  return { id: id, tripId: id, date: date, entity: c.entity >= 0 ? String(row[c.entity] || "") : "", notes: String(row[c.notes] || ""),
    route: cleanRouteString(row[c.route]), rawRoute: String(row[c.route] || ""),
    stops: stops, stopsCount: stops, stopCount: stops, totalKm: totalKm, km: totalKm, synced: true };
}

function successResponse(action, trip, duplicate) {
  return { success: true, status: "success", action: action, duplicate: duplicate,
    id: trip.id, tripId: trip.tripId, totalKm: trip.totalKm, km: trip.totalKm,
    date: trip.date, route: trip.route, stops: trip.stops, entity: trip.entity, notes: trip.notes, trip: trip };
}

function tripFields(entity, notes) {
  const entities = ["Glen Reyes (Sole Prop)", "H4 Community (Unreimbursed)"];
  if (entity !== undefined && typeof entity !== "string") throw new Error("Invalid tax entity. No trip was changed.");
  const text = String(notes || "");
  const legacy = entities.find(label => text.startsWith(label + " — "));
  const explicit = String(entity || "").trim();
  if (explicit && entities.indexOf(explicit) < 0) throw new Error("Invalid tax entity. No trip was changed.");
  return { entity: explicit || legacy || "", notes: legacy ? text.slice(legacy.length + 3) : text };
}

function validateKm(value) {
  if (typeof value !== "number" && typeof value !== "string") throw new Error("Distance must be a number greater than 0 km.");
  const number = Number(value);
  if (!Number.isFinite(number) || !Number.isFinite(roundKm(number)) || number <= 0 || roundKm(number) <= 0) {
    throw new Error("Distance must be a finite number greater than 0 km. No trip was saved.");
  }
  return roundKm(number);
}

function roundKm(value) { return Math.round(value * 10) / 10; }

function validateDate(value) {
  const date = String(value).trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new Error("Date must use YYYY-MM-DD.");
  const parsed = new Date(date + "T12:00:00Z");
  if (isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== date) throw new Error("Invalid trip date.");
  return date;
}

function sheetText(value) {
  const text = String(value == null ? "" : value);
  return /^\s*[=+@-]/.test(text) ? "'" + text : text;
}

function cleanRouteString(value) {
  const text = String(value || "").trim();
  if (!text) return "Trip";
  // Split separators, preserving hyphens inside school and street names.
  const segments = text.split(/\s*(?:→|->|\||>)\s*|\s+[–—-]\s+|\s+to\s+/i).filter(Boolean);
  const result = [];
  segments.forEach((segment, index) => {
    const cleaned = segment.trim();
    if (/^home(?:\b|$)/i.test(cleaned) || /\bdalmatian\b/i.test(cleaned)) {
      if (index === segments.length - 1 && result.length) result.push("Home");
      return;
    }
    const match = KNOWN_LOCATIONS.find(location =>
      location[1].some(pattern => cleaned.toLowerCase().includes(pattern.toLowerCase())));
    result.push(match ? match[0] : cleaned.split(",")[0].trim());
  });
  return result.length ? result.join(" → ") : "Home Circuit";
}

function errorResponse(error) {
  const message = error && error.message ? error.message : String(error);
  return createJsonResponse({ success: false, status: "error", error: message, message: message });
}

function createJsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);
}
